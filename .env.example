# Copy to .env (or .env.local) and fill in. Never commit real values.

# --- xAI -------------------------------------------------------------------
# Server-side key. Optional if you save a key in Settings or use a session-only key in the UI.
# Phone calls need either this or a key saved in Settings.
XAI_API_KEY=
# Voice model. Pin a versioned name (grok-voice-think-fast-2.0) in production.
VOICE_MODEL=grok-voice-latest
TEXT_MODEL=grok-4.3
# Prompt optimiser model and reasoning effort (low | medium | high). grok-4.6 cannot turn reasoning off.
OPTIMIZER_MODEL=grok-4.6
OPTIMIZER_REASONING_EFFORT=low

# --- App -------------------------------------------------------------------
APP_ENV=development
# all | app | telephony (see docs/deploy/cloudrun.md for the two-service layout)
ROLE=all
# 32-byte urlsafe base64 key that encrypts stored API keys and secrets. Required in production.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=
# Builder access: none (local only) | token | proxy (IAP, Cloudflare Access, oauth2-proxy)
AUTH_MODE=none
ADMIN_TOKEN=
PROXY_USER_HEADER=x-goog-authenticated-user-email
# Public HTTPS URL where xAI can reach /webhooks/xai/call-incoming. Needed for SIP.
PUBLIC_BASE_URL=
# Postgres for production (postgresql://user:pass@host:5432/db). Empty = SQLite in DATA_DIR.
DATABASE_URL=
DATA_DIR=
CORS_ORIGINS=["http://localhost:5173"]
SEED_EXAMPLE=true
# Host port for docker compose (the container always listens on 8000).
HOST_PORT=8000

# --- Runtime ---------------------------------------------------------------
# in_session: handoffs switch voice with session.update | keep: keep the first voice
HANDOFF_VOICE_MODE=in_session
# Store every realtime event (except audio and transcript deltas) for each conversation.
RECORD_EVENTS=true
TOOL_TIMEOUT_S=15
MCP_TOOL_TIMEOUT_S=60
# JSON list of hosts or CIDRs that HTTP tools and MCP servers may reach on private networks.
SSRF_ALLOWLIST=[]
PLUGINS_DIR=

# --- Knowledge -------------------------------------------------------------
# fastembed (local, no key) | openai_compatible
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_API_BASE=
EMBEDDINGS_API_KEY=

# --- Observability (optional) ---------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
